---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import { getHome, getPageMarkdown, getUi } from '../lib/content';
import { localizedPath, type Locale, type PageKey } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = getHome(locale);
const ui = getUi(locale);
const page = await getPageMarkdown(locale, 'home');
const Content = page.Content;
---

<Base locale={locale} page="home" title={page.title} description={page.description}>
  <Hero
    locale={locale}
    eyebrow={home.hero.eyebrow}
    title={home.hero.title}
    lead={home.hero.lead}
    cta={home.hero.cta}
    slides={home.hero.slides}
  />

  <div class="pod-divider my-2" aria-hidden="true"></div>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-forest">{home.origin.title}</p>
    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      {
        [home.origin.bahia, home.origin.aveiro].map((block) => (
          <article class="overflow-hidden rounded-3xl bg-white/70 shadow-[0_20px_50px_-28px_rgba(60,36,21,0.4)]">
            <img src={block.image} alt={block.alt} class="h-64 w-full object-cover" />
            <div class="p-6 sm:p-8">
              <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-forest">{block.kicker}</p>
              <h2 class="mt-2 font-serif text-3xl text-cocoa">{block.title}</h2>
              <p class="mt-3 text-cocoa-mid">{block.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-cream/80">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-forest">{home.family.kicker}</p>
        <h2 class="mt-3 font-serif text-4xl text-cocoa sm:text-5xl">{home.family.title}</h2>
        <p class="mt-5 max-w-xl text-lg text-cocoa-mid">{home.family.text}</p>
        <div class="prose-cocoa mt-8 text-cocoa-mid">
          <Content />
        </div>
        <a
          href={localizedPath('story', locale)}
          class="mt-8 inline-flex rounded-full border border-cocoa/20 px-5 py-2.5 text-sm font-semibold text-cocoa hover:border-forest hover:text-forest"
        >
          {ui.cta.story}
        </a>
      </div>
      <img
        src="/images/slide/caixa-na-mao-4x3.webp"
        alt=""
        class="h-full min-h-80 w-full rounded-3xl object-cover"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      {
        home.teasers.map((teaser) => (
          <a
            href={localizedPath(teaser.page as PageKey, locale)}
            class="group overflow-hidden rounded-3xl bg-white/80 shadow-[0_18px_40px_-24px_rgba(60,36,21,0.45)]"
          >
            <img
              src={teaser.image}
              alt={teaser.alt}
              class="h-48 w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            />
            <div class="p-6">
              <h3 class="font-serif text-2xl text-cocoa">{teaser.title}</h3>
              <p class="mt-2 text-sm text-cocoa-mid">{teaser.text}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="bg-cocoa text-cream">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-5 py-16 sm:px-8 lg:flex-row lg:items-center">
      <div>
        <h2 class="font-serif text-4xl">{home.ctaBand.title}</h2>
        <p class="mt-3 max-w-xl text-cream/80">{home.ctaBand.text}</p>
      </div>
      <a
        href={localizedPath('contact', locale)}
        class="inline-flex rounded-full bg-forest px-6 py-3 text-sm font-semibold text-white hover:bg-forest-dark"
      >
        {home.ctaBand.button}
      </a>
    </div>
  </section>
</Base>
