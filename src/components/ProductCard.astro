---
interface Props {
  name: string;
  kicker: string;
  description: string;
  packaging: string[];
  images: string[];
  imageAlt: string;
  featured?: boolean;
  ctaHref: string;
  ctaLabel: string;
}

const { name, kicker, description, packaging, images, imageAlt, featured = false, ctaHref, ctaLabel } =
  Astro.props;
---

<article
  class:list={[
    'overflow-hidden rounded-3xl border border-cocoa/10 bg-white/80 shadow-[0_20px_50px_-28px_rgba(60,36,21,0.45)]',
    featured ? 'grid gap-0 lg:grid-cols-2' : 'flex flex-col',
  ]}
>
  <div class:list={['relative bg-cream', featured ? 'min-h-72' : 'aspect-[4/3]']}>
    <img src={images[0]} alt={imageAlt} class="h-full w-full object-cover" />
    {
      featured && (
        <p class="absolute left-4 top-4 rounded-full bg-forest px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-white">
          {kicker}
        </p>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-8">
    {
      !featured && (
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-forest">{kicker}</p>
      )
    }
    <h3 class="mt-2 font-serif text-2xl font-semibold text-cocoa sm:text-3xl">{name}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-cocoa-mid sm:text-base">{description}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        packaging.map((item) => (
          <li class="rounded-full bg-cream px-3 py-1 text-xs text-cocoa-mid">{item}</li>
        ))
      }
    </ul>
    {
      images.length > 1 && (
        <div class="mt-5 flex gap-2">
          {images.slice(1, 4).map((src) => (
            <img src={src} alt="" class="h-16 w-16 rounded-xl object-cover ring-1 ring-cocoa/10" />
          ))}
        </div>
      )
    }
    <a
      href={ctaHref}
      class="mt-6 inline-flex w-fit items-center rounded-full bg-forest px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-forest-dark"
    >
      {ctaLabel}
    </a>
  </div>
</article>
