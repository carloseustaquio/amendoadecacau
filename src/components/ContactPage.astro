---
import Base from '../layouts/Base.astro';
import InquiryForm from './InquiryForm.astro';
import { getContact, getPageMarkdown, getUi } from '../lib/content';
import { FACEBOOK_URL, INSTAGRAM_URL, inquiryEmail } from '../lib/site';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const contact = getContact(locale);
const ui = getUi(locale);
const page = await getPageMarkdown(locale, 'contact');
const Content = page.Content;
const email = inquiryEmail();
---

<Base locale={locale} page="contact" title={page.title} description={page.description} image="/images/logo-round.webp">
  <section class="bg-cream">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:py-20">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-forest">{contact.kicker}</p>
        <h1 class="mt-3 font-serif text-4xl text-cocoa sm:text-5xl">{contact.title}</h1>
        <p class="mt-5 text-lg text-cocoa-mid">{contact.lead}</p>
        <div class="prose-cocoa mt-6 text-cocoa-mid">
          <Content />
        </div>
        <aside class="mt-10 rounded-3xl bg-white/80 p-6">
          <h2 class="font-serif text-2xl text-cocoa">{contact.asideTitle}</h2>
          <ul class="mt-3 grid gap-2 text-sm text-cocoa-mid">
            {contact.aside.map((line) => <li>{line}</li>)}
          </ul>
          <p class="mt-4 text-sm">
            <a class="font-semibold text-forest" href={`mailto:${email}`}>{email}</a>
          </p>
          <p class="mt-3 flex gap-4 text-sm">
            <a href={INSTAGRAM_URL} class="underline decoration-forest/30" target="_blank" rel="noreferrer">
              {ui.footer.instagram}
            </a>
            <a href={FACEBOOK_URL} class="underline decoration-forest/30" target="_blank" rel="noreferrer">
              {ui.footer.facebook}
            </a>
          </p>
        </aside>
      </div>
      <div>
        <h2 class="font-serif text-3xl text-cocoa">{ui.form.title}</h2>
        <p class="mt-2 mb-6 text-cocoa-mid">{ui.form.intro}</p>
        <InquiryForm copy={ui.form} />
      </div>
    </div>
  </section>
</Base>
