---
import Base from '../layouts/Base.astro';
import { getFarm, getPageMarkdown, getUi } from '../lib/content';
import { localizedPath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const farm = getFarm(locale);
const ui = getUi(locale);
const page = await getPageMarkdown(locale, 'farm');
const Content = page.Content;
---

<Base locale={locale} page="farm" title={page.title} description={page.description} image={farm.hero.image}>
  <section class="relative min-h-[62vh] overflow-hidden bg-cocoa-deep text-cream">
    <img src={farm.hero.image} alt={farm.hero.alt} class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-cocoa-deep/85 via-cocoa-deep/45 to-transparent"></div>
    <div class="relative mx-auto flex min-h-[62vh] max-w-6xl items-end px-5 py-16 sm:px-8">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-gold">{farm.hero.eyebrow}</p>
        <h1 class="mt-3 font-serif text-4xl sm:text-6xl">{farm.hero.title}</h1>
        <p class="mt-5 text-lg text-cream/90">{farm.hero.lead}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        farm.facts.map((fact) => (
          <div class="rounded-2xl bg-white/80 p-5">
            <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-forest">{fact.label}</dt>
            <dd class="mt-1 font-serif text-2xl text-cocoa">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="prose-cocoa mt-12 text-cocoa-mid">
      <Content />
    </div>
  </section>

  <section class="bg-cream/80">
    <div class="mx-auto grid max-w-6xl gap-6 px-5 py-16 sm:grid-cols-2 sm:px-8">
      {
        farm.gallery.map((item) => (
          <figure class="overflow-hidden rounded-3xl bg-white">
            <img src={item.src} alt={item.alt} class="h-72 w-full object-cover sm:h-80" />
            <figcaption class="px-5 py-4 text-sm text-cocoa-mid">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="mx-auto flex max-w-6xl justify-end px-5 py-12 sm:px-8">
    <a
      href={localizedPath('products', locale)}
      class="inline-flex rounded-full bg-forest px-6 py-3 text-sm font-semibold text-white hover:bg-forest-dark"
    >
      {ui.cta.products}
    </a>
  </section>
</Base>
