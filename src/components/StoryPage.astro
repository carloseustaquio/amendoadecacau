---
import Base from '../layouts/Base.astro';
import { getPageMarkdown, getStory, getUi } from '../lib/content';
import { localizedPath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const story = getStory(locale);
const ui = getUi(locale);
const page = await getPageMarkdown(locale, 'story');
const Content = page.Content;
---

<Base locale={locale} page="story" title={page.title} description={page.description} image="/images/logo-4x3.webp">
  <section class="border-b border-cocoa/10 bg-cream">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:py-24">
      <img
        src={story.portrait.src}
        alt={story.portrait.alt}
        class="mx-auto w-full max-w-sm rounded-full bg-forest"
      />
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-forest">{story.hero.eyebrow}</p>
        <h1 class="mt-3 font-serif text-4xl text-cocoa sm:text-6xl">{story.hero.title}</h1>
        <p class="mt-5 max-w-xl text-lg text-cocoa-mid">{story.hero.lead}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <ol class="grid gap-6 md:grid-cols-2">
      {
        story.timeline.map((item) => (
          <li class="rounded-3xl bg-white/75 p-6 shadow-[0_16px_40px_-28px_rgba(60,36,21,0.45)] sm:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-forest">{item.year}</p>
            <h2 class="mt-2 font-serif text-2xl text-cocoa sm:text-3xl">{item.title}</h2>
            <p class="mt-3 text-cocoa-mid">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="bg-cream/90">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 sm:px-8 lg:grid-cols-2">
      <div class="prose-cocoa text-cocoa-mid">
        <Content />
        <a
          href={localizedPath('contact', locale)}
          class="mt-8 inline-flex rounded-full bg-forest px-5 py-2.5 text-sm font-semibold text-white hover:bg-forest-dark"
        >
          {ui.cta.inquire}
        </a>
      </div>
      <img
        src="/images/cacau-e-trabalhador.webp"
        alt=""
        class="h-full min-h-80 w-full rounded-3xl object-cover"
      />
    </div>
  </section>
</Base>
